# ============================================================================
# EduAudit AI - Environment Variables Template
# Copy to .env and fill in your values
# ============================================================================

# Application
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=DEBUG

# Database (PostgreSQL with pgvector + PostGIS)
DATABASE_URL=postgresql://eduaudit:eduaudit_secure_2026@localhost:5432/eduaudit

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 (for media storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
S3_BUCKET=eduaudit-media

# Cloudinary (for CDN + image transformations)
CLOUDINARY_URL=cloudinary://your-key:your-secret@your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name

# AI Models
MODEL_PATH=models/yolov11_nano.pt
CLIP_MODEL_NAME=ViT-L/14
EMBEDDING_MODEL=BAAI/bge-m3

# LLM (choose one)
OPENAI_API_KEY=sk-your-openai-key
# GEMINI_API_KEY=your-gemini-key

# SMS Gateway (MSG91)
MSG91_AUTH_KEY=your-msg91-auth-key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_ANON=30
RATE_LIMIT_USER=60
RATE_LIMIT_UPLOAD=10

# Monitoring
SENTRY_DSN=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
